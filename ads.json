{
  "schemaVersion": 1,
  "enabled": true,
  "initialDelaySeconds": 300,
  "showDurationSeconds": 5,
  "repeatEverySeconds": 5,
  "countdown": {
    "enabled": true,
    "seconds": 5,
    "autoCloseAtZero": true
  },
  "behavior": {
    "selectionMode": "sequence",
    "refreshConfigBeforeShow": true
  },
  "overlay": {
    "enabled": true,
    "scrimColor": "#99000000",
    "dismissOnOutsideTap": false,
    "gravity": "center",
    "paddingDp": 16
  },
  "ads": [
    {
      "id": "sample-house-ad",
      "enabled": true,
      "elements": [
        {
          "type": "card",
          "widthPercent": 92,
          "maxWidthDp": 520,
          "paddingDp": 16,
          "marginDp": 8,
          "backgroundColor": "#FF20222C",
          "cornerRadiusDp": 20,
          "children": [
            {
              "type": "image",
              "src": "https://your-cdn.example/house-ad.jpg",
              "aspectRatio": "16:9",
              "contentScale": "crop",
              "cornerRadiusDp": 14,
              "clickable": true,
              "url": "https://www.amazon.com/dp/EXAMPLE"
            },
            {
              "type": "countdown",
              "position": "topRight",
              "sizeDp": 42,
              "marginDp": 8,
              "style": "circle",
              "backgroundColor": "#CC111111",
              "textColor": "#FFFFFFFF",
              "autoCloseAtZero": true
            },
            {
              "type": "spacer",
              "heightDp": 12
            },
            {
              "type": "title",
              "text": "Your title from ads.json",
              "textSizeSp": 22,
              "textColor": "#FFFFFFFF",
              "gravity": "center"
            },
            {
              "type": "subtitle",
              "text": "The whole layout and action are remote controlled.",
              "textSizeSp": 14,
              "textColor": "#FFD7D7D7",
              "gravity": "center",
              "marginDp": 4
            },
            {
              "type": "divider",
              "color": "#44FFFFFF",
              "heightDp": 1,
              "marginDp": 10
            },
            {
              "type": "button",
              "text": "Open Amazon",
              "backgroundColor": "#FF6C4DFF",
              "textColor": "#FFFFFFFF",
              "cornerRadiusDp": 12,
              "paddingDp": 8,
              "marginDp": 4,
              "url": "amzn://apps/android?p=com.amazon.mShop.android.shopping"
            }
          ]
        }
      ]
    }
  ]
}
